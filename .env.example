# Salin menjadi .env. JANGAN commit .env.
DEBUG=1
SECRET_KEY=ganti-dengan-string-acak-panjang
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
